]
}
tool_select_house={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":56)
]
}
time_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":32)
]
}
time_speed_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":61)
]
}
time_speed_down={
