; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Neues Spiel"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

TimeTickSystem="*res://src/time_tick_system/time_tick_system.gd"
ResourceItemDatabase="*res://src/resource_item_database/resource_item_database.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[input]

build_place={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)
]
}
build_remove={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)
]
}
camera_rotate_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":81)
]
}
camera_rotate_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":69)
]
}
tool_select_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":49)
]
}
tool_select_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"keycode":50)
]
}
